# Allow-list: the image needs only what the Dockerfile copies.
*
!backend/
!migrations/
!scripts/db_migrate.py
!requirements-runtime.txt

# Never inside the allowed folders: secrets, local state, caches.
**/.env
**/.env.*
**/__pycache__
**/*.pyc
backend/*.db
backend/*.db-*
backend/*.db.*
backend/uploads/
