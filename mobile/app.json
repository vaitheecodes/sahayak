{
  "expo": {
    "name": "Sahayak",
    "slug": "sahayak",
    "scheme": "sahayak",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vaitheeswaran.sahayak"
    },
    "android": {
      "package": "com.vaitheeswaran.sahayak",
      "adaptiveIcon": {
        "backgroundColor": "#17687B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1F4F6",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "dark": { "backgroundColor": "#0E1114" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
