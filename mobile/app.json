{
  "expo": {
    "slug": "sahayak",
    "scheme": "sahayak",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#17687B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1F4F6",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0E1114"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Sahayak to attach photos from your library to a support ticket.",
          "cameraPermission": "Allow Sahayak to take a photo to attach to a support ticket.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
